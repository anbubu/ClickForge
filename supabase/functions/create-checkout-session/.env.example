# Copy to `.env` for local `supabase functions serve` runs — never commit the real `.env`.
# In production these are set with `supabase secrets set --env-file .env` instead.
# STRIPE_SECRET_KEY, SUPABASE_URL, and SUPABASE_SERVICE_ROLE_KEY are the same
# values used by ../stripe-webhook — secrets are shared project-wide, not per-function.

STRIPE_SECRET_KEY=sk_test_...
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Price ids from the Stripe Dashboard (Product catalog -> price -> `price_...`).
STRIPE_PRICE_CREATOR=price_...
STRIPE_PRICE_STUDIO=price_...

# Where Stripe redirects after checkout. Defaults to these values if unset.
CHECKOUT_SUCCESS_URL=https://app.clickforge.com/checkout/success
CHECKOUT_CANCEL_URL=https://app.clickforge.com/pricing
