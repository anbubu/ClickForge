# Copy to `.env` for local `supabase functions serve` runs — never commit the real `.env`.
# In production these are set with `supabase secrets set --env-file .env` instead.

# Stripe test-mode secret key (sk_test_...) for local dev; sk_live_... in production.
STRIPE_SECRET_KEY=sk_test_...

# From `stripe listen` locally (it prints a whsec_... on startup); from the
# Stripe Dashboard's webhook endpoint config in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# Local: from `supabase start` output. Production: your project's API URL.
SUPABASE_URL=http://localhost:54321

# Local: the `service_role` key from `supabase start` output. Production: from
# Project Settings -> API. Never expose this to the client app.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
