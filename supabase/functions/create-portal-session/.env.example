# Copy to `.env` for local `supabase functions serve` runs — never commit the real `.env`.
# In production these are set with `supabase secrets set --env-file .env` instead.
# STRIPE_SECRET_KEY, SUPABASE_URL, and SUPABASE_SERVICE_ROLE_KEY are the same
# values used by ../stripe-webhook and ../create-checkout-session — secrets
# are shared project-wide, not per-function.

STRIPE_SECRET_KEY=sk_test_...
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Where Stripe returns the user after they leave the portal. Defaults to this
# value if unset.
PORTAL_RETURN_URL=https://app.clickforge.com/account
